# BotFather bergan token
BOT_TOKEN=1234567890:AAAA-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Adminlarning Telegram ID raqamlari (vergul bilan). ID ni @userinfobot orqali bilib olasiz
ADMIN_IDS=123456789,987654321

# Mini App manzili (HTTPS bo'lishi shart, oxirida /app)
WEBAPP_URL=https://davomat.sizningdomen.uz/app

# Ichki veb-server (Caddy/nginx shu yerga yo'naltiradi)
WEB_HOST=127.0.0.1
WEB_PORT=8080

DB_PATH=davomat.db
TIMEZONE=Asia/Tashkent

# GPS aniqligi shundan yomon bo'lsa (metr) qabul qilinmaydi
MAX_GPS_ACCURACY=300
